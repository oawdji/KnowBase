# Chat Provider, remember to set the api key / base url / model for the provider
CHAT_PROVIDER=openai

# Embeddings Provider, remember to set the api key / base url / model for the provider
EMBEDDINGS_PROVIDER=openai

# Chat title auto-naming: the first user message becomes the title (truncated),
# then a background model call refines it. Set to false to skip the extra call.
CHAT_TITLE_LLM=true
CHAT_TITLE_MAX_LENGTH=30
CHAT_TITLE_LLM_TIMEOUT=15

# OpenAI settings (required if CHAT_PROVIDER=openai or EMBEDDINGS_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDINGS_MODEL=text-embedding-ada-002

# Deepseek settings (required if CHAT_PROVIDER=deepseek)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# Deepseek model could be deepseek-chat or deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# Ollama settings (required if CHAT_PROVIDER=ollama, in docker compose, use host.docker.internal instead of localhost)

# If you are using macOS with docker-compose, you can use host.docker.internal
OLLAMA_API_BASE=http://host.docker.internal:11434

# If you used a compiled installation, you can use http://localhost:11434
# OLLAMA_API_BASE=http://localhost:11434

# If you are a Linux server using docker-compose, you need to use the host machine's IP address.
# OLLAMA_API_BASE=http://172.17.0.1:11434

OLLAMA_MODEL=deepseek-r1:7b
# Ollama Embedding Model (required if EMBEDDINGS_PROVIDER=ollama)
OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text

# HuggingFace settings (required if EMBEDDINGS_PROVIDER=huggingface)
# HuggingFace API key is optional - only needed for gated models or API usage
HUGGINGFACE_API_KEY=
# HuggingFace Embedding Model (code default: sentence-transformers/all-MiniLM-L6-v2)
#
# ⚠️ 上游默认的 all-MiniLM-L6-v2 是英文语料、384 维、上限 256 token，检索中文资料效果很差。
#    本仓库推荐换成中文模型，并放进仓库的 ./models/ 目录后填「容器内路径」：
#        HUGGINGFACE_EMBEDDINGS_MODEL=/app/models/bge-small-zh-v1.5
#    （./models 在 docker-compose.dev.yml 里已挂载为 /app/models，且已被 .gitignore 忽略）
#    常见选择：
#      - BAAI/bge-small-zh-v1.5   中文，512 维，体积小（约 97 MB），本仓库实际在用
#      - BAAI/bge-m3              中文，1024 维，效果更好但更大
#      - sentence-transformers/all-MiniLM-L6-v2   英文，384 维，上游默认值
#    也可以直接填 HuggingFace 仓库名（会联网下载），但本机到 huggingface.co / hf-mirror.com
#    的连接会被重置（实测 TLS UNEXPECTED_EOF），这种情况建议改从 ModelScope 下载。
HUGGINGFACE_EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ⚠️ 换了向量模型必须重建索引：新旧向量的维度与语义空间都不兼容，旧向量会直接检索失败
#    （报错形如 Collection expecting embedding with dimension of 384, got 512）。
#    操作：删除旧知识库 → 新建知识库 → 重新上传文档。

# 离线加载开关（可选）：模型已在本地时设为 1，huggingface 客户端不再联网校验版本。
# 不设的话它会逐个文件重试 5 次（1+2+4+8+8 秒），冷启动可能白等一两分钟。
# 本项目已由 docker-compose.dev.yml 的 environment 注入 HF_HUB_OFFLINE=1（开发版专用）。
# 注意：生产 docker-compose.yml 没有模型目录挂载、也没有模型缓存卷，那边不要打开这一项。
# HF_HUB_OFFLINE=1

# 下载模型时使用的镜像地址（仅在需要联网下载模型时才生效）
# HF_ENDPOINT=https://hf-mirror.com

# DashScope settings (optional - required only if using DashScope)
DASH_SCOPE_API_KEY=
DASH_SCOPE_EMBEDDINGS_MODEL=

# MiniMax settings (required if CHAT_PROVIDER=minimax)
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_API_BASE=https://api.minimax.io/v1
# MiniMax model could be MiniMax-M2.7 or MiniMax-M2.7-highspeed
MINIMAX_MODEL=MiniMax-M2.7

# MinIO settings (required)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=documents

# Vector Store settings (required)
VECTOR_STORE_TYPE=chroma

# Chroma DB settings (required if VECTOR_STORE_TYPE=chroma)
CHROMA_DB_HOST=chromadb
CHROMA_DB_PORT=8000

# Qdrant DB settings (optional - required only if VECTOR_STORE_TYPE=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_PREFER_GRPC=true

# MySQL settings (required)
MYSQL_SERVER=db
MYSQL_PORT=3306
MYSQL_USER=ragwebui
MYSQL_PASSWORD=ragwebui
MYSQL_DATABASE=ragwebui

# JWT settings (required)
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Timezone settings (optional)
TZ=Asia/Shanghai
